# Campanha R (se houver infraestrutura): namespace querido-diario-tcc no Revoada.
# Parâmetros fixados em docs/avaliacao/protocolo.md ("Parâmetros fixados"):
# mudam N do E1 (500), o teto (o do D5) e o passo das séries (30 s).
# Pré-requisitos: VPN (`sudo wg-quick up revoada`) e o pod export-metrics
# (o run_experiment.sh o cria se faltar).

: "${AMBIENTE:=revoada}"
: "${CONTEXTO:=revoada-testes}"
: "${NAMESPACE:=querido-diario-tcc}"

: "${OVERLAY_A:=k8s/overlays/revoada-tcc}"
: "${OVERLAY_FILA:=k8s/overlays/revoada-tcc-queue}"
: "${OVERLAY_FILA_MONITORAMENTO:=}"   # os PodMonitors já vêm no revoada-tcc-queue
: "${IMAGEM_MODO_A:=}"                # o overlay já fixa a imagem por digest nos três modos
# Digest fixado em k8s/overlays/revoada-tcc/imagens. Desde o piloto (25/11/2026):
# tcc-fila-pushadd-144d805, a mesma imagem da campanha K (ID bd8fc4251012; no
# kind o digest é o do kind load, sha256:58fc08b3…), com o pushadd do
# data-processing#133. Antes: tcc-fila@sha256:addd0fcb… (deployment PR #67)
: "${IMAGEM_DIGEST:=sha256:1d71dc6bf836e54fec2cd5d59b68c662dc8a7c5e5453642909c67595d67dbf28}"

# Sem port-forward para o namespace monitoring: o checklist e o export rodam
# de dentro do pod export-metrics (simulador/k8s/export-metrics-pod.yaml)
: "${PROMETHEUS_SVC:=}"

: "${TERRITORIO:=3299999}"
: "${N_E1:=500}"
: "${N_R1:=500}"               # o R1 fica fora da campanha R (protocolo)
: "${N_ROBUSTEZ:=100}"
: "${CORROMPIDOS_R2:=10}"
: "${TETO:=6}"                 # o do D5 (#31); acompanha o patch-teto.yaml do overlay
: "${VISIBILITY_TIMEOUT_R1:=300}"
: "${FRACAO_FALHA_R1:=0.10}"
: "${FRACAO_FALHA_R3:=0.25}"
: "${INDISPONIBILIDADE_R3_S:=60}"
: "${JANELA_E2_S:=1800}"
: "${OCIOSO_S:=120}"
: "${PASSO_S:=30}"

# 3 × t0→t_vazio do E1-A no piloto válido (E1-A-pilotoi, 26/11/2026: 702 s)
: "${TIMEOUT_S:=2106}"
: "${TIMEOUT_ZERO_S:=900}"
: "${TIMEOUT_JOB_S:=1800}"

: "${ORCAMENTO_H:=6.5}"
: "${LIMITE_H:=24}"
