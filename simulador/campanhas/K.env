# Campanha K (obrigatória): kind local, em uma única máquina.
# Parâmetros fixados em docs/avaliacao/protocolo.md ("Parâmetros fixados").
# Mudar algo aqui depois da primeira execução válida é um desvio do protocolo:
# registrar na seção "Desvios do protocolo", com a data e o motivo.
#
# Lido pelo run_experiment.sh e pelo run_campaign.sh com `source`. Uma variável
# já definida no ambiente tem precedência (ex.: TIMEOUT_S=600 simulador/run_experiment.sh ...).

: "${AMBIENTE:=kind}"
: "${CONTEXTO:=kind-querido-diario-dev}"
: "${NAMESPACE:=querido-diario}"

# Overlays do querido-diario-deployment (QD_DEPLOYMENT_DIR)
: "${OVERLAY_A:=k8s/overlays/dev}"
: "${OVERLAY_FILA:=k8s/overlays/dev-queue}"
# PodMonitors do worker e do redis-queue: no kind ficam fora do overlay dev-queue
: "${OVERLAY_FILA_MONITORAMENTO:=k8s/components/queue-pipeline/monitoring}"
# No kind, o overlay dev deixa o CronJob em :latest; o modo A é apontado para a
# mesma imagem da fila (protocolo, "Mesma imagem de código")
: "${IMAGEM_MODO_A:=ghcr.io/okfn-brasil/querido-diario-data-processing:tcc-fila}"
# Digest (sha256:...) da imagem registrado para a campanha. Vazio até o piloto:
# o piloto grava o digest em uso no .json; copie-o para cá antes das válidas
: "${IMAGEM_DIGEST:=}"

# Prometheus (o run_experiment.sh abre um port-forward para o checklist; o
# export_metrics.py abre o dele)
: "${PROMETHEUS_SVC:=monitoring/monitoring-kube-prometheus-prometheus}"

# Carga e cenários
: "${TERRITORIO:=3299999}"
: "${N_E1:=300}"
: "${N_R1:=300}"
: "${N_ROBUSTEZ:=100}"        # R1a, R2, R3 (e M1, que é um R2)
: "${CORROMPIDOS_R2:=10}"
: "${TETO:=2}"                 # teto do modo C (overlay dev-queue)
: "${VISIBILITY_TIMEOUT_R1:=300}"
: "${FRACAO_FALHA_R1:=0.10}"   # R1/R1a: mata o worker com ~10% processados (fila restante > timeout + 2 min)
: "${FRACAO_FALHA_R3:=0.25}"   # R3: OpenSearch fora com ~25% processados
: "${INDISPONIBILIDADE_R3_S:=60}"
: "${JANELA_E2_S:=1800}"
: "${OCIOSO_S:=120}"           # espera ociosa antes de cada execução
: "${PASSO_S:=15}"             # passo do query_range do export_metrics.py

# Timeout de uma execução: 3 × a duração do E1 do modo A no piloto. Até o
# piloto, um valor folgado; revisar depois dele
: "${TIMEOUT_S:=7200}"
: "${TIMEOUT_ZERO_S:=900}"     # C: espera pelas réplicas voltarem a 0 depois de t_vazio
: "${TIMEOUT_JOB_S:=1800}"     # A: espera pelo fim do Job (temas e push) depois de t_vazio

# Orçamento (protocolo, "Orçamento de tempo")
: "${ORCAMENTO_H:=14.5}"
: "${LIMITE_H:=24}"
